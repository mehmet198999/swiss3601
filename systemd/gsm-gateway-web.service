# =====================================================================
#  gsm-gateway-web.service
#
#  Kleine lokale Statusseite: http://gsm-gateway.local
#
#  Sicherheit:
#    * laeuft als unprivilegierter Systembenutzer gsm-web
#    * liefert nur /run/gsm-gateway/status.json aus (read only)
#    * weist Anfragen von oeffentlichen IP-Adressen selbst zurueck
#    * zusaetzlich durch nftables auf das LAN begrenzt
#
#  Installiert nach: /etc/systemd/system/gsm-gateway-web.service
# =====================================================================
[Unit]
Description=GSM Gateway Statusseite (nur LAN)
After=network-online.target gsm-gateway-status.service
Wants=network-online.target

[Service]
Type=simple
User=gsm-web
Group=gsm-web
ExecStart=/usr/bin/python3 /opt/gsm-gateway/web/status/status-server.py
Restart=on-failure
RestartSec=5

# Port 80 ohne root-Rechte.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Absicherung
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
